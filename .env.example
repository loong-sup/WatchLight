# Watchlight-Py local environment example.
# Copy this file to .env and replace placeholder values.

# Model providers. At least one provider key is needed for real model replies.
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web search. Optional, but recommended for deep research.
TAVILY_API_KEY=

# Gateway/runtime.
WATCHLIGHT_STATE_DIR=.watchlight-state
WATCHLIGHT_CONFIG_PATH=

# Feishu app credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Feishu webhook mode only. Not required for WebSocket long-connection mode.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# WeCom intelligent bot API mode (internal DM and group @bot).
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_BOT_NAME=Watchlight
# Internal intelligent bots use an empty receive id.
WECOM_RECEIVE_ID=

# Internal signed test endpoint.
WATCHLIGHT_FEISHU_INTERNAL_SECRET=change-me

# Feishu cloud docs.
WATCHLIGHT_FEISHU_DOCS_WRITE_ENABLED=false
FEISHU_DOCS_BASE_URL=https://your-company.feishu.cn
